rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Tudo que não está liberado abaixo é negado.
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Companies (configuração e token do WhatsApp de cada empresa)
    // Somente o backend acessa, pelo Admin SDK, que não passa por estas regras.
    // O painel lê e altera esses dados pelas rotas /api/meta, com login verificado.
    match /companies/{empresaId} {
      allow read, write: if false;
    }

    // 3. Leads do CRM: cada lead pertence ao usuário que o criou (campo ownerUid).
    match /leads/{leadId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}

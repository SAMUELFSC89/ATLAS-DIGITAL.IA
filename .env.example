# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META_APP_ID: Meta App ID used for official Embedded Signup OAuth Dialog and App token exchange.
META_APP_ID=""

# META_CLIENT_SECRET: Meta App Client Secret used for swapping the authorization code for access tokens.
META_CLIENT_SECRET=""

# GOOGLE_PLACES_API_KEY: chave da Places API (New) do Google Cloud.
# O Radar de Mercado usa esta chave para buscar empresas reais no Google Maps.
GOOGLE_PLACES_API_KEY=""

# FIREBASE_SERVICE_ACCOUNT: JSON da conta de serviço do Firebase (texto ou base64).
# Necessária quando o servidor roda fora do Google Cloud (ex.: Vercel), para
# gravar e ler a conexão do WhatsApp no Firestore.
FIREBASE_SERVICE_ACCOUNT=""

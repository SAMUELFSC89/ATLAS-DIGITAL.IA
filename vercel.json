{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/contato",
      "destination": "/contato.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/radar-recurring?run=scheduled",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/radar-recurring.ts": {
      "maxDuration": 60
    }
  }
}

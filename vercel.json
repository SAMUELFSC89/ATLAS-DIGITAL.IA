{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/site-express",
      "destination": "/api/contact?expressEndpoint=site"
    },
    {
      "source": "/api/site-express-webhook",
      "destination": "/api/contact?expressEndpoint=webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/contato",
      "destination": "/contato.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/radar?view=recurring&run=scheduled",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/radar.ts": {
      "maxDuration": 60
    },
    "api/contact.ts": {
      "maxDuration": 45
    }
  },
  "headers": [
    {
      "source": "/site-express",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}

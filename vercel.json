{
  "version": 2,
  "rewrites": [
    {
      "source": "/proposta/:token",
      "destination": "/api/site-express?view=builder&action=proposal&token=:token"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/site-express?view=builder&action=published&slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/contato",
      "destination": "/contato.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos-de-servico",
      "destination": "/termos-de-servico.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/radar?view=recurring&run=scheduled",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/radar.ts": {
      "maxDuration": 60
    },
    "api/contact.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/site-express.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/site-express-webhook.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/site-express",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/criar-site",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
